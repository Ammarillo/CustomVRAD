// =============================================================================
// PathRAD Hammer entities (volumes, IES, fog, extra light keys).
// =============================================================================
// Tools -> Options -> Game Configurations -> Game Data Files
// Add this AFTER garrysmod.fgd (or your game FGD), then restart Hammer.
// =============================================================================

// -----------------------------------------------------------------------------
// light_env_vol - sky/sun override volume (brush)
// Place like a trigger (tools/toolstrigger or nodraw).
// Old classname light_environment_volume still works.
// -----------------------------------------------------------------------------
@SolidClass base(Targetname, Angles) color(255 255 0) = light_env_vol :
	"Bake-only sky/sun override volume. " +
	"Same lighting keys as light_environment. " +
	"Outside the brush (and in the fade) lighting mixes with the map light_environment.\n" +
	"\n" +
	"LightTemperature / AmbientTemperature (K), 0 = use RGB.\n" +
	"Typical sun:\n" +
	"- 3500  golden hour\n" +
	"- 5600  noon\n" +
	"- 6500  overcast\n" +
	"Typical ambient (usually cooler):\n" +
	"- 7500  shade\n" +
	"- 10000  blue sky\n" +
	"Examples:\n" +
	"- indoor volume  3000 sun / 4000 ambient\n" +
	"- outdoor        5600 sun / 8000 ambient"
[
	_light(color255) : "Brightness and Color" : "255 255 255 200" : "The sunlight color. Last number is the brightness."
	_ambient(color255) : "Ambient Color and Brightness" : "255 255 255 20" : "Ambient color in shadows. Last number is the brightness."
	_lightHDR(color255) : "Color and Brightness (HDR)" : "-1 -1 -1 1" : "Leave as '-1 -1 -1 1' to use the SDR values."
	_ambientHDR(color255) : "Ambient Color and Brightness (HDR)" : "-1 -1 -1 1" : "Leave as '-1 -1 -1 1' to use the SDR values."
	_lightscaleHDR(float) : "HDR Brightness Scale" : "1" : "Amount to scale the light by when compiling for HDR."
	_AmbientScaleHDR(float) : "HDR Ambient Brightness Scale" : "1" : "Amount to scale the ambient light by when compiling for HDR."
	pitch(integer) : "Pitch" : 0 : "Overrides the pitch value in Angles. Negative is down. 0 is horizontal, -90 is straight down."
	SunSpreadAngle(float) : "Sun Spread Angle" : 0 : "Softens sunlight shadows (degrees). 0 = hard. Higher numbers are more diffuse."
	BlendDistance(float) : "Blend Distance" : 0 : "World units for the soft fade (smootherstep). Where the fade sits is set by Blend Mode. 0 = hard cut."
	BlendMode(choices) : "Blend Mode" : 2 : "Where Blend Distance is applied relative to the brush face. Soft Voronoi still stops one volume from tinting another's side." =
	[
		0 : "Inside (fade inward from face)"
		1 : "Outside (fade outward from face)"
		2 : "Center (fade straddles face)"
	]
	priority(integer) : "Priority" : 0 : "When volumes fully overlap (core), higher priority wins. Ties use the smaller volume."
	BounceVolColor(choices) : "Bounce Color From Volume" : 0 : "Recolor bounced light inside this volume to this volume's Brightness (_light) hue. Applies to all radiosity gathered in the volume." =
	[
		0 : "No (natural bounce color)"
		1 : "Yes (volume color)"
	]
	BounceVolBright(choices) : "Bounce Bright From Volume" : 0 : "Only applies if Bounce Color From Volume is Yes. No keeps bounce luminance; Yes also scales brightness by this volume's _light intensity vs the map light_environment." =
	[
		0 : "No (keep luminance)"
		1 : "Yes (scale to volume brightness)"
	]
	OutsideCastShadowIn(choices) : "OutsideCastShadowIn" : 1 : "Outside geometry casts sun/sky shadows into this volume. No = outside blockers are ignored for samples inside." =
	[
		0 : "No"
		1 : "Yes"
	]
	InsideCastShadowOut(choices) : "InsideCastShadowOut" : 1 : "Inside geometry casts sun/sky shadows outside this volume. No = inside blockers are ignored for samples outside." =
	[
		0 : "No"
		1 : "Yes"
	]
	LightTemperature(float) : "Color Temperature (K)" : "0" : "Optional blackbody CCT for sun Brightness (_light). 0 = keep RGB. When set, RGB is replaced; brightness (4th number) is kept.\n" +
		"\n" +
		"Typical values:\n" +
		"- 3500  golden hour\n" +
		"- 4500  late afternoon\n" +
		"- 5600  noon daylight\n" +
		"- 6500  overcast\n" +
		"- 8000  high / blue sky\n" +
		"\n" +
		"Examples:\n" +
		"- 5600  outdoor noon\n" +
		"- 3500  sunset\n" +
		"- 3000  indoor volume (warm skylight)\n" +
		"- 6500  overcast day"
	AmbientTemperature(float) : "Ambient Temperature (K)" : "0" : "Optional blackbody CCT for Ambient (_ambient). 0 = keep RGB. Same Kelvin scale as Color Temperature. Sky fill is usually cooler than the sun.\n" +
		"\n" +
		"Typical values:\n" +
		"- 4000   indoor bounce\n" +
		"- 6500   overcast fill\n" +
		"- 7500   open shade\n" +
		"- 10000  clear blue sky\n" +
		"- 20000  twilight\n" +
		"\n" +
		"Examples:\n" +
		"- 5600 sun + 8000 ambient   noon\n" +
		"- 6500 sun + 7500 ambient   overcast\n" +
		"- 3000 sun + 4000 ambient   interior volume"
]

// -----------------------------------------------------------------------------
// light_ao - global AO settings (POINT entity - Entity Tool, not Tie to Entity)
// Optional. Without this, use CLI -ao / -ao_* or only light_ao_vol volumes.
// -----------------------------------------------------------------------------
@PointClass base(Targetname) color(180 200 255) size(-8 -8 -8, 8 8 8) = light_ao :
	"Map-wide ambient occlusion defaults for PathRAD. " +
	"Place with the Entity Tool (not Tie to Entity on a brush). " +
	"Sets Samples / Distance / Strength / Bias for the whole map. " +
	"Override locally with light_ao_vol brushes."
[
	Enabled(choices) : "Enabled" : 1 : "Master switch for map-wide AO. Volumes can still enable AO inside their bounds when this is No." =
	[
		0 : "No"
		1 : "Yes"
	]
	Samples(integer) : "Samples" : 16 : "Hemisphere rays per luxel (quality vs compile time)."
	Distance(float) : "Distance" : "48" : "AO ray length in world units."
	Strength(float) : "Strength" : "1.0" : "Darkening strength. 0 = off, 1 = normal, above 1 boosts (e.g. 1.5-3). Max 8."
	Bias(float) : "Bias" : "0.25" : "Offset along surface normal to reduce self-occlusion (too high causes bright edge leaks)."
	Denoise(choices) : "Denoise" : 0 : "Optional edge-preserving filter on the AO lightmap (reduces ray noise)." =
	[
		0 : "No"
		1 : "Yes"
	]
	DenoiseRadius(integer) : "Denoise Radius" : 1 : "Filter radius in luxels (1 = 3x3, 2 = 5x5). Only used if Denoise is Yes."
	DenoiseStrength(float) : "Denoise Strength" : "1.0" : "How much to blend toward the filtered AO (0..1). Only used if Denoise is Yes."
]

// -----------------------------------------------------------------------------
// light_ao_vol - AO override volume (brush)
// Place like a trigger (tools/toolstrigger or nodraw).
// -----------------------------------------------------------------------------
@SolidClass base(Targetname) color(180 200 255) = light_ao_vol :
	"Ambient occlusion override volume. " +
	"Same AO keys as light_ao. " +
	"Outside the brush (and in the fade) settings mix with light_ao / command-line defaults."
[
	Enabled(choices) : "Enabled" : 1 : "AO inside this volume. Set No to carve out a region with no AO when the map default is on." =
	[
		0 : "No"
		1 : "Yes"
	]
	Samples(integer) : "Samples" : 16 : "Hemisphere rays per luxel inside this volume."
	Distance(float) : "Distance" : "48" : "AO ray length in world units."
	Strength(float) : "Strength" : "1.0" : "Darkening strength. 0 = off, 1 = normal, above 1 boosts (e.g. 1.5-3). Max 8."
	Bias(float) : "Bias" : "0.25" : "Offset along surface normal to reduce self-occlusion (too high causes bright edge leaks)."
	BlendDistance(float) : "Blend Distance" : 0 : "World units for the soft fade (smootherstep). Where the fade sits is set by Blend Mode. 0 = hard cut."
	BlendMode(choices) : "Blend Mode" : 2 : "Where Blend Distance is applied relative to the brush face." =
	[
		0 : "Inside (fade inward from face)"
		1 : "Outside (fade outward from face)"
		2 : "Center (fade straddles face)"
	]
	priority(integer) : "Priority" : 0 : "When volumes fully overlap (core), higher priority wins. Ties use the smaller volume."
]

// -----------------------------------------------------------------------------
// light_absorb - light absorber volume (brush)
// Place like a trigger (tools/toolstrigger or nodraw).
// -----------------------------------------------------------------------------
@SolidClass base(Targetname) color(120 80 160) = light_absorb :
	"Absorbs bounce (and optionally direct) lighting inside this brush. " +
	"Soft fade works the same way as light_env_vol."
[
	Strength(float) : "Strength" : "0.5" : "How much light to absorb (0 = none, 1 = full). Soft-blended by Blend Distance."
	AbsorbDirect(choices) : "Absorb Direct" : 0 : "Also damp direct lights (sun/point/spot) at sample positions." =
	[
		0 : "No"
		1 : "Yes"
	]
	AbsorbBounce(choices) : "Absorb Bounce" : 1 : "Damp radiosity bounce through/into this volume." =
	[
		0 : "No"
		1 : "Yes"
	]
	BlendDistance(float) : "Blend Distance" : 0 : "World units for the soft fade (smootherstep). 0 = hard cut."
	BlendMode(choices) : "Blend Mode" : 2 : "Where Blend Distance is applied relative to the brush face." =
	[
		0 : "Inside (fade inward from face)"
		1 : "Outside (fade outward from face)"
		2 : "Center (fade straddles face)"
	]
	priority(integer) : "Priority" : 0 : "When volumes fully overlap (core), higher priority wins. Ties use the smaller volume."
]

// -----------------------------------------------------------------------------
// light_bounce_vol - local bounce_boost / bounce_chroma overrides (brush)
// Place like a trigger (tools/toolstrigger or nodraw).
// -----------------------------------------------------------------------------
@SolidClass base(Targetname) color(255 160 80) = light_bounce_vol :
	"Local bounce boost / chroma / energy inside this brush. " +
	"Outside (and in the fade) settings mix with -bounce_boost / -bounce_chroma / -energy. " +
	"Use with -texbounce if you want colored bounce."
[
	BounceBoost(float) : "Bounce Boost" : "-1" : "Artistic bounce brightness scale inside this volume (0..16). -1 = use CLI -bounce_boost (default 1)."
	BounceChroma(float) : "Bounce Chroma" : "-1" : "Early-bounce saturation boost inside this volume (0..8). -1 = use CLI -bounce_chroma (default 0). Strongest on first bounce."
	EnergyMode(choices) : "Energy Mode" : -1 : "Override cavity-damped radiosity inside this volume. Soft-blends with CLI -energy / -noenergy in the blend shell." =
	[
		-1 : "Inherit (CLI -energy / -noenergy)"
		1 : "Energy (cavity damp)"
		0 : "No Energy (stock Valve)"
	]
	BlendDistance(float) : "Blend Distance" : 0 : "World units for the soft fade (smootherstep). 0 = hard cut."
	BlendMode(choices) : "Blend Mode" : 2 : "Where Blend Distance is applied relative to the brush face." =
	[
		0 : "Inside (fade inward from face)"
		1 : "Outside (fade outward from face)"
		2 : "Center (fade straddles face)"
	]
	priority(integer) : "Priority" : 0 : "When volumes fully overlap (core), higher priority wins. Ties use the smaller volume."
]

// -----------------------------------------------------------------------------
// bake_volume - local rebake region (brush)
// Place like a trigger (tools/toolstrigger or nodraw).
// -----------------------------------------------------------------------------
@SolidClass base(Targetname) color(80 220 140) = bake_volume :
	"Only rebake lighting samples (luxels / prop verts) whose world position is inside this brush. " +
	"A face or prop that sticks out keeps cached lighting on the part outside. " +
	"Geometry outside still shadows and bounces in; it is not itself recalculated. " +
	"Lighting outside comes from the previous compile (mapsrc/<map>.vradlm). " +
	"Full-bake the map once, then add volumes for local updates. " +
	"Ignore all bake_volume entities with VRAD -nobakevolume."
[
	Enabled(choices) : "Enabled" : 1 : "Disable to ignore this volume (full-map bake if every volume is off)." =
	[
		0 : "No"
		1 : "Yes"
	]
	Rebake(choices) : "Rebake" : 0 : "What to recompute inside this volume." =
	[
		0 : "Both (lightmaps + props)"
		1 : "Lightmaps only"
		2 : "Props only"
	]
	Padding(float) : "Touch Padding" : "8" : "World units to expand the brush AABB when testing sample/vertex positions (catches surfaces sitting on the boundary)."
]

// -----------------------------------------------------------------------------
// light / light_environment - stock entities + optional Kelvin CCT (PathRAD)
// Replaces the stock definitions when this FGD is loaded after the game FGD.
// LightTemperature 0 = use Brightness RGB. When set, RGB is replaced; 4th number kept.
// -----------------------------------------------------------------------------
@PointClass base(Targetname, Light) iconsprite("editor/light.vmt") sphere(_fifty_percent_distance) sphere(_zero_percent_distance) = light :
	"An invisible omnidirectional light source.\n" +
	"PathRAD LightTemperature (K): 0 = use Brightness RGB.\n" +
	"\n" +
	"Typical values:\n" +
	"- 1800  candle / fire\n" +
	"- 2700  incandescent\n" +
	"- 3000  warm LED\n" +
	"- 4000  cool white\n" +
	"\n" +
	"Examples:\n" +
	"- 2700  room lamps\n" +
	"- 1800  candles / fire\n" +
	"- 4000  office / workshop\n" +
	"- 0     custom RGB (neon, coloured LED)"
[
	LightTemperature(float) : "Color Temperature (K)" : "0" : "Optional blackbody CCT in Kelvin. 0 = keep Brightness RGB. When set, RGB is replaced; brightness (4th number) is kept. Also tints the exported engine worldlight.\n" +
		"\n" +
		"Typical values:\n" +
		"- 1800  candle / fire\n" +
		"- 2200  vintage filament\n" +
		"- 2700  incandescent\n" +
		"- 3000  halogen / warm LED\n" +
		"- 3500  neutral white\n" +
		"- 4000  cool white / fluorescent\n" +
		"- 5000  noon-ish\n" +
		"- 5600  daylight / flash\n" +
		"- 6500  overcast\n" +
		"\n" +
		"Examples:\n" +
		"- 2700  living-room lamps\n" +
		"- 3000  museum / shop bulbs\n" +
		"- 4000  office / workshop\n" +
		"- 1800  candles\n" +
		"- 0     non-blackbody colour (neon, RGB LED)"
]

@PointClass base(Targetname, Angles) iconsprite("editor/light_env.vmt") = light_environment :
	"Special light used for lighting the entire map from the sky.\n" +
	"PathRAD LightTemperature / AmbientTemperature (K), 0 = use RGB.\n" +
	"\n" +
	"Typical sun:\n" +
	"- 3500  golden hour\n" +
	"- 5600  noon\n" +
	"- 6500  overcast\n" +
	"Typical ambient (usually cooler):\n" +
	"- 7500  shade\n" +
	"- 10000  blue sky\n" +
	"Example:\n" +
	"- noon  5600 sun / 8000 ambient"
[
	pitch(integer) : "Pitch" : 0 : "The downward pitch of the light from the sun. 0 is horizontal, -90 is straight down."
	_light(color255) : "Brightness" : "255 255 255 200" : "Sun color. Last number is brightness."
	_ambient(color255) : "Ambient" : "255 255 255 20" : "Ambient color in shadows. Last number is brightness."
	_lightHDR(color255) : "Brightness HDR" : "-1 -1 -1 1" : "Leave as '-1 -1 -1 1' to use the SDR values."
	_ambientHDR(color255) : "Ambient HDR" : "-1 -1 -1 1" : "Leave as '-1 -1 -1 1' to use the SDR values."
	_lightscaleHDR(float) : "Brightness Scale HDR" : "1" : "Amount to scale the light by when compiling for HDR."
	_AmbientScaleHDR(float) : "Ambient Scale HDR" : "1" : "Amount to scale the ambient light by when compiling for HDR."
	SunSpreadAngle(float) : "SunSpreadAngle" : 0 : "Angular extent of the sun for casting soft shadows (degrees). 0 = hard."
	LightTemperature(float) : "Color Temperature (K)" : "0" : "Optional blackbody CCT for sun Brightness (_light). 0 = keep RGB. When set, RGB is replaced; brightness (4th number) is kept.\n" +
		"\n" +
		"Typical values:\n" +
		"- 3500  golden hour\n" +
		"- 4500  late afternoon\n" +
		"- 5600  noon daylight\n" +
		"- 6500  overcast\n" +
		"- 8000  high / blue sky\n" +
		"\n" +
		"Examples:\n" +
		"- 5600  outdoor noon\n" +
		"- 3500  sunset\n" +
		"- 6500  overcast day"
	AmbientTemperature(float) : "Ambient Temperature (K)" : "0" : "Optional blackbody CCT for Ambient (_ambient). 0 = keep RGB. Same Kelvin scale as Color Temperature. Sky fill is usually cooler than the sun.\n" +
		"\n" +
		"Typical values:\n" +
		"- 4000   indoor bounce\n" +
		"- 6500   overcast fill\n" +
		"- 7500   open shade\n" +
		"- 10000  clear blue sky\n" +
		"- 20000  twilight\n" +
		"\n" +
		"Examples:\n" +
		"- 5600 sun + 8000 ambient   noon\n" +
		"- 6500 sun + 7500 ambient   overcast\n" +
		"- 8000 sun + 12000 ambient  night"
]

// -----------------------------------------------------------------------------
// light_spot - stock spot + optional IES photometric profile (PathRAD)
// Replaces the stock light_spot definition when this FGD is loaded after the game FGD.
// Keep stock lightprop/lightcone helpers (iconsprite draws a white billboard plane).
// IES is bake-only (not exported to engine worldlights). When IES is set, VRAD ignores
// _inner_cone / _cone / _exponent for the lightmap bake.
// -----------------------------------------------------------------------------
@PointClass base(Targetname, Angles, Light) lightprop("models/editor/spot.mdl") lightcone() line(255 220 50, targetname, target) sphere(_fifty_percent_distance) sphere(_zero_percent_distance) = light_spot :
	"Spot light. PathRAD: set IES to an .ies photometric file to drive the beam shape. " +
	"When IES is set, Inner/Outer cone and Focus are ignored for the bake (engine dynamic lighting still uses cones). " +
	"Use IESBrightness for bake intensity (leave Brightness at 0 to disable engine dynamic light). " +
	"ProjectedTexture: materials/ path to a planar VTF (framed to the outer cone) or cubemap / spherical envmap VTF; auto-detected. " +
	"If both IES and ProjectedTexture are set, IES acts as an angular mask on the projection. " +
	"Editor: thin frustum = forward beam; yellow line appears when Target is set. " +
	"Asymmetric IES/projection: rotate Yaw (or Roll) to spin around the beam.\n" +
	"\n" +
	"LightTemperature (K): 0 = use Brightness RGB.\n" +
	"Typical values:\n" +
	"- 2700  incandescent\n" +
	"- 3000  halogen / warm LED\n" +
	"- 4000  cool white\n" +
	"Examples:\n" +
	"- 3000  museum / shop spots\n" +
	"- 2700  interior downlights\n" +
	"- 4000  workshop floods"
[
	target(target_destination) : "Entity to point at" : : "The name of an entity in the map that the spotlight will point at. This will override the spotlight's angles."
	_inner_cone(integer) : "Inner (bright) angle (ignored if IES set)" : 30 : "Inner spotlight cone degrees. Ignored for bake when IES is set."
	_cone(integer) : "Outer (fading) angle (ignored if IES set)" : 45 : "Outer spotlight cone degrees. Ignored for bake when IES is set, except it still frames planar ProjectedTexture images. Still drives the editor cone preview."
	_exponent(integer) : "Focus (ignored if IES set)" : 1 : "Cone fringe exponent. Ignored for bake when IES is set."
	_distance(integer) : "Maximum distance" : 0 : "This is the distance that light is allowed to cast, in inches."
	pitch(angle_negative_pitch) : "Pitch" : -90
	spawnflags(Flags) = [ 1 : "Initially dark" : 0 ]
	IES(string) : "IES Profile" : "" : "Filename under garrysmod/IES/ (e.g. museum_spot.ies). Also checks IES/maps/<map>/. Bake-only - replaces cone angles. With ProjectedTexture, used as angular mask."
	IESScale(float) : "IES Scale" : "1" : "Scales IES angular response (1 = peak matches bake brightness)."
	IESBrightness(float) : "IES Brightness" : "-1" : "Bake brightness (same units as _light 4th). -1 = use stock Brightness. When >= 0, overrides stock brightness for the lightmap bake only - engine worldlights still use Brightness above (set that to 0 to disable dynamic light)."
	IESMaxIntensity(float) : "IES Max Lightmap Intensity" : "0" : "Caps max RGB of this light's direct contribution per luxel sample (0 = off). Use to tame hot IES peaks without lowering overall brightness."
	ProjectedTexture(string) : "Projected Texture" : "" : "Material path under materials/ (e.g. lights/gobos/logo). Planar VTF = framed to outer cone; cubemap = omnidirectional. Auto-detected. Bake-only. Multiplies light RGB; with IES, IES masks the projection."
	ProjectedTextureMode(choices) : "2D Projection Mode" : "fill" : "How a planar ProjectedTexture is framed in the outer cone. Ignored for cubemaps / spherical maps." =
	[
		"fill" : "Fill - square sides touch the cone (corners clipped)"
		"fit" : "Fit - whole square inside the cone (corners visible)"
	]
	LightTemperature(float) : "Color Temperature (K)" : "0" : "Optional blackbody CCT in Kelvin. 0 = keep Brightness RGB. When set, RGB is replaced; brightness (4th number) is kept. Also tints the exported engine worldlight.\n" +
		"\n" +
		"Typical values:\n" +
		"- 1800  candle / fire\n" +
		"- 2200  vintage filament\n" +
		"- 2700  incandescent\n" +
		"- 3000  halogen / warm LED\n" +
		"- 3500  neutral white\n" +
		"- 4000  cool white / fluorescent\n" +
		"- 5000  noon-ish\n" +
		"- 5600  daylight / flash\n" +
		"- 6500  overcast\n" +
		"\n" +
		"Examples:\n" +
		"- 3000  museum / shop spots\n" +
		"- 2700  interior downlights\n" +
		"- 4000  workshop floods\n" +
		"- 5600  daylight-balanced fixtures\n" +
		"- 0     non-blackbody colour (neon, RGB LED)"
]

// -----------------------------------------------------------------------------
// fog_volume - bake a 3D light grid into the BSP, rewrite the entity to lua_run.
// -----------------------------------------------------------------------------
@SolidClass base(Targetname) color(140 180 220) = fog_volume :
	"Volumetric fog. VRAD bakes a 3D light grid and packs shaders/materials into the BSP. " +
	"At the end of compile this entity becomes two lua_run entities (setup + draw, no addon) " +
	"that draw a screenspace raymarch using the baked grid. Brush is bounds only (tools/toolstrigger)."
[
	Enabled(choices) : "Enabled" : 1 : "Disable to skip bake for this volume (no fog material / lua)." =
	[
		0 : "No"
		1 : "Yes"
	]
	StartEnabled(choices) : "Start Enabled" : 1 : "Runtime on/off at map load (ConVar cvf_en). Toggle live with cvf_en 0/1." =
	[
		0 : "No"
		1 : "Yes"
	]
	FogColor(color255) : "Fog Color" : "200 220 255" : "Fog albedo / tint (RGB). Brightness is driven by the baked light grid."
	Density(float) : "Density" : "0.02" : "Optical density per world unit. Start low (0.01-0.05)."
	LightBoost(float) : "Direct Light Boost" : "1.0" : "Multiplier on DIRECT light in the fog (bounce/ambient unaffected). 1 = neutral, 2-4 = light shafts pop, values clamp at white."
	Anisotropy(float) : "Anisotropy" : "0" : "Henyey-Greenstein phase anisotropy (-1 back .. 0 isotropic .. 1 forward)."
	GridSpacing(float) : "Grid Spacing" : "32" : "World units between light-grid samples. Lower = sharper lighting, heavier bake. Clamped to max 64^3 samples."
	StepCount(integer) : "Raymarch Steps" : 32 : "Screenspace raymarch quality (8-128)."
	BlendDistance(float) : "Blend Distance" : 0 : "World units for soft fade at the volume edge (0-2047). Outside/Center also expand the baked light grid by this amount. 0 = hard cut."
	BlendMode(choices) : "Blend Mode" : 2 : "Where Blend Distance is applied relative to the brush face. Outside/Center expand raymarch + light-grid bake by Blend Distance." =
	[
		0 : "Inside (fade inward from face)"
		1 : "Outside (fade outward from face)"
		2 : "Center (fade straddles face)"
	]
	NoiseScale(float) : "Noise Scale" : "0" : "Baked 3D FBM noise scale (0=off). World frequency; typical 0.01-0.05. Try 0.02. Noise is packed into the BSP as a tileable 32^3 atlas."
	NoiseCoverage(float) : "Noise Coverage" : "0.45" : "Cloud coverage 0-1. Lower = more holes / thinner puffs."
	WindSpeed(float) : "Wind Speed" : "8" : "World-space scroll speed (units/sec). Decimals OK (e.g. 0.5, 2.5). Start low."
	WindDir(float) : "Wind Dir (yaw)" : "0" : "Wind direction in degrees (0 = +X, 90 = +Y). Quantized to 45° steps."
	priority(integer) : "Priority" : 0 : "When volumes overlap, higher priority wins for soft-edge conflicts (runtime uses independent draws)."
]

// -----------------------------------------------------------------------------
// fog_volume_blocker - carves fog out of overlapping fog_volume brushes
// Place like a trigger. Soft edge via BlendDistance. Compile-only (rewritten to info_null).
// -----------------------------------------------------------------------------
@SolidClass base(Targetname) color(220 100 80) = fog_volume_blocker :
	"Cuts fog out of overlapping fog_volume brushes (baked into the light-grid atlas alpha). " +
	"Use tools/toolstrigger. Removed at compile end (becomes info_null)."
[
	Enabled(choices) : "Enabled" : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	BlendDistance(float) : "Blend Distance" : 16 : "Soft fade from blocker face into the blocked interior (world units). 0 = hard cut."
]

// -----------------------------------------------------------------------------
// water_light_vol - override underwater bake IOPs for BSP water
// Place like a trigger over water. Does not create water — overrides leafWaterData.
// Requires -underwater or -uw_volume on the VRAD command line.
// -----------------------------------------------------------------------------
@SolidClass base(Targetname) color(40 120 180) = water_light_vol :
	"Override underwater absorption and scattering for overlapping BSP water. " +
	"Water materials still supply $fogcolor / $fogend by default (UseVmt). " +
	"Needs VRAD -underwater or -uw_volume."
[
	Enabled(choices) : "Enabled" : 1 =
	[
		0 : "No"
		1 : "Yes"
	]
	UseVmt(choices) : "Use VMT Fog" : 1 : "Start from the water surface VMT $fog* / $vrad_uw_* then apply entity overrides." =
	[
		0 : "No (entity only)"
		1 : "Yes"
	]
	Jerlov(string) : "Jerlov Type" : "" : "Optional Jerlov preset: I, IA, IB, II, III, 1C, 3C, 5C, 7C, 9C. Empty = keep VMT/fog fit."
	SigmaA(string) : "Sigma A (RGB)" : "" : "Absorption coefficients per channel (1/unit). Empty = unchanged."
	SigmaS(string) : "Sigma S (RGB)" : "" : "Scattering coefficients per channel (1/unit). Empty = unchanged."
	Anisotropy(float) : "HG Anisotropy" : "0.8" : "Henyey-Greenstein g for -uw_volume (−1..1)."
	FogColor(color255) : "Fog Color" : "13 31 46" : "Optional override of water fog tint used to fit extinction."
	FogEnd(float) : "Fog End" : "" : "Optional visibility distance (hammer units). Empty = leave VMT $fogend."
	priority(integer) : "Priority" : 0 : "Higher wins when several water_light_vol brushes overlap the same water body."
]

// -----------------------------------------------------------------------------
// light_volume - soft sphere point light (POINT entity)
// Same editor look/keys as stock light (Light base), plus Radius.
// Requires garrysmod.fgd (or equivalent) loaded before this FGD.
// -----------------------------------------------------------------------------
@PointClass base(Targetname, Light) iconsprite("editor/light.vmt") sphere(_fifty_percent_distance) sphere(_zero_percent_distance) sphere(Radius) = light_volume :
	"Soft-sphere point light. Same settings as a normal light, plus Radius. " +
	"VRAD samples the origin inside the sphere so shadows have a penumbra. " +
	"The engine still gets a normal point light at the center.\n" +
	"\n" +
	"LightTemperature (K): 0 = use Brightness RGB.\n" +
	"Typical values:\n" +
	"- 1800  candle / fire\n" +
	"- 2700  incandescent\n" +
	"- 3000  warm LED\n" +
	"- 4000  cool white\n" +
	"Examples:\n" +
	"- 2700  hanging bulb\n" +
	"- 1800  fire / lantern (raise Radius for a soft glow)"
[
	Radius(float) : "Soft Radius" : "16" : "Sphere radius for soft-shadow sampling (world units). 0 = hard point. Default 16. Soft samples scale with radius (like SunSpreadAngle)."
	LightTemperature(float) : "Color Temperature (K)" : "0" : "Optional blackbody CCT in Kelvin. 0 = keep Brightness RGB. When set, RGB is replaced; brightness (4th number) is kept. Also tints the exported engine worldlight.\n" +
		"\n" +
		"Typical values:\n" +
		"- 1800  candle / fire\n" +
		"- 2200  vintage filament\n" +
		"- 2700  incandescent\n" +
		"- 3000  halogen / warm LED\n" +
		"- 3500  neutral white\n" +
		"- 4000  cool white / fluorescent\n" +
		"- 5000  noon-ish\n" +
		"- 5600  daylight / flash\n" +
		"- 6500  overcast\n" +
		"\n" +
		"Examples:\n" +
		"- 2700  hanging bulb\n" +
		"- 1800  fire / lantern (raise Radius for a soft glow)\n" +
		"- 3000  warm ceiling globes\n" +
		"- 0     non-blackbody colour (neon, RGB LED)"
]
