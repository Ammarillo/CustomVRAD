# =============================================================================
# Keep sources, FGDs, configs, docs, and shaders.
# Ignore build output, local deploy trees, editor caches, and scratch files.
# =============================================================================

# -----------------------------------------------------------------------------
# Compiler / linker / MSVC intermediates
# -----------------------------------------------------------------------------
*.d
*.slo
*.lo
*.o
*.obj
*.gch
*.pch
*.ilk
*.iobj
*.ipdb
*.pdb
*.exp
*.lib
*.idb
*.pgc
*.pgd
*.sbr
*.tlb
*.tli
*.tlh
*_i.c
*_p.c
*.mdmp
*.tlog
*.ipch
*.bin
*.cache
*.rsp

**/Release/
**/Debug/
**/x64/Release/
**/x64/Debug/

# -----------------------------------------------------------------------------
# Binaries (build + local Hammer drop)
# -----------------------------------------------------------------------------
*.dll
*.exe
*.so
*.dylib
*.a
*.la
*.lai
*.out
*.app

# Output / install trees (any depth)
bin/
game/
dist/
bundle/

# -----------------------------------------------------------------------------
# Local-only / non-distribution trees
# -----------------------------------------------------------------------------
map_test/
pertinents/

# Valve VPC caches (vcxproj is what we ship)
*.vpc
*.vpc_cache

# Steamworks API dump (not required for PathRAD build)
src/public/steam/steam_api.json

# Downloaded third-party SDKs (see thirdparty READMEs)
thirdparty/oidn/
thirdparty/oidn-*/

# ShaderCompile toolchain (local). Keep HLSL, include/, and fxc/*.vcs.
shaders/tools/

# -----------------------------------------------------------------------------
# IDE / editor / OS
# -----------------------------------------------------------------------------
.vs/
.cursor/
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.VC.opendb
*.vsidx
*.opendb
*.suo
*.db
*.db-shm
*.db-wal
ipch/
*.aps
*.ncb
*.opensdf
*.sdf

# Keep workspace tasks / language association / highlighter colors:
#   .vscode/settings.json  .vscode/tasks.json
# (do not ignore .vscode/)

*~
*.bak
*.swp
*.swo
*.tmp
*.temp
Thumbs.db
Desktop.ini
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/

